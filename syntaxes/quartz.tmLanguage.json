{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Quartz",
  "scopeName": "source.quartz",
  "patterns": [
    { "include": "#comments" },
    { "include": "#annotations" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#declarations" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.quartz", "match": "//.*$" },
        { "name": "comment.block.quartz", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "annotations": {
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
      "name": "entity.name.function.decorator.quartz"
    },
    "strings": {
      "name": "string.quoted.double.quartz",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.quartz", "match": "\\\\." },
        {
          "name": "meta.interpolation.quartz",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.quartz" } },
          "endCaptures": { "0": { "name": "punctuation.section.embedded.end.quartz" } },
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.quartz", "match": "\\b(if|else|match|for|in|while|break|continue|return|wait|at|scope|every)\\b" },
        { "name": "keyword.other.quartz", "match": "\\b(package|import|pub|internal|private|let|var|const|fn|suspend|struct|state|enum|trait|impl|ref|as|is)\\b" },
        { "name": "constant.language.quartz", "match": "\\b(true|false|null)\\b" },
        { "name": "variable.language.self.quartz", "match": "\\bself\\b" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.other.quartz" }, "2": { "name": "entity.name.function.quartz" } }
        },
        {
          "match": "\\b(struct|state|enum|trait|impl)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.other.quartz" }, "2": { "name": "entity.name.type.quartz" } }
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.quartz", "match": "\\b0[xX][0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.binary.quartz", "match": "\\b0[bB][01_]+\\b" },
        { "name": "constant.numeric.float.quartz", "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b" },
        { "name": "constant.numeric.integer.quartz", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.quartz", "match": "\\b(int|float|str|bool|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64)\\b" },
        { "name": "entity.name.type.quartz", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "name": "entity.name.function.call.quartz"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.quartz", "match": "=>|->|\\?\\?|\\.\\.=?|[-+*/%&|^~!<>=]=?|<<|>>|&&|\\|\\||\\?" }
      ]
    }
  }
}
