{
  "name": "basalt-devtools",
  "displayName": "Basalt DevTools",
  "description": "Create, build, check and pack WebAssembly plugins for Basalt with Kiln",
  "version": "26.3.0",
  "publisher": "basaltproject",
  "license": "GPL-3.0-only",
  "repository": { "type": "git", "url": "https://github.com/BasaltProject/DevTools.git" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Programming Languages", "Linters", "Other"],
  "icon": "docs/assets/basalt-icon.png",
  "main": "./extension.js",
  "activationEvents": ["workspaceContains:**/plugin.toml", "onCommand:basalt.newPlugin"],
  "scripts": {
    "lint": "node --check extension.js && node --check lib/kiln.js && node --check lib/manifest.js && node --check lib/toml.js && node --check scripts/generate-abi.js",
    "test": "node test/logic.test.js",
    "generate": "node scripts/generate-abi.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "3.6.0"
  },
  "contributes": {
    "commands": [
      { "command": "basalt.newPlugin", "title": "Basalt: New Plugin" },
      { "command": "basalt.build", "title": "Basalt: Build" },
      { "command": "basalt.check", "title": "Basalt: Check" },
      { "command": "basalt.pack", "title": "Basalt: Pack" },
      { "command": "basalt.installToolchain", "title": "Basalt: Install Toolchain" },
      { "command": "basalt.searchImport", "title": "Basalt: Search ABI import" }
    ],
    "configuration": {
      "title": "Basalt",
      "properties": {
        "basalt.target": {
          "type": "string",
          "enum": ["server", "proxy"],
          "default": "server",
          "description": "The product a new plugin is for."
        },
        "basalt.kilnPath": {
          "type": "string",
          "default": "",
          "description": "The Kiln executable. Empty looks for `kiln` on the PATH."
        },
        "basalt.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run `kiln check` when a plugin.toml is saved and show what it finds in the Problems panel."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "kiln",
        "required": ["command"],
        "properties": {
          "command": { "type": "string", "enum": ["build", "check", "pack"], "description": "The Kiln command." },
          "folder": { "type": "string", "description": "The plugin folder, the one with plugin.toml." }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "kiln",
        "owner": "kiln",
        "source": "kiln",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(?:kiln \\w+: )?([^\\s:][^:]*[./][^:\\s]*?)(?::(\\d+))?: (?!error: |warning: )(.+)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      },
      {
        "name": "kiln-compiler",
        "owner": "kiln-compiler",
        "source": "kiln",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(?:kiln \\w+: )?(.+?):(\\d+):(?:(\\d+):)? (error|warning|fatal error): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ]
  }
}
