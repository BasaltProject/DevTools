@handle
@awaitable
struct Delay {}

impl int {
    @property
    fn ticks(self) -> Delay
    @property
    fn seconds(self) -> Delay
    @property
    fn minutes(self) -> Delay
}

fn serverTick() -> int

fn setCancelled(value: bool)
fn setMessage(text: str)

@handle
struct Player {
    name: str,
    uuid: str,
    world: str,
    gamemode: str,
    address: str,
    level: int,
    food: int,
    ping: int,
    permissionLevel: int,
    health: float,
    x: float,
    y: float,
    z: float,
    yaw: float,
    pitch: float,
    sneaking: bool,
    flying: bool,
    onGround: bool
}

impl Player {
    fn send(self, message: str)
    fn actionBar(self, message: str)
    fn title(self, title: str, subtitle: str)
    fn kick(self, reason: str)
    fn teleport(self, world: str, x: float, y: float, z: float) -> bool
    fn setHealth(self, value: float)
    fn setFood(self, value: int)
    fn setLevel(self, value: int)
    fn setGamemode(self, mode: str)
    fn give(self, item: str, count: int) -> bool
    fn heldItem(self) -> str
    fn hasPermission(self, node: str) -> bool
    fn sound(self, name: str, volume: float, pitch: float)
}

fn playerCount() -> int
fn onlinePlayers() -> [Player]
fn playerNamed(name: str) -> Player?
fn playerByUuid(uuid: str) -> Player?
fn isOnline(p: Player) -> bool
fn broadcast(message: str)
fn runConsole(command: str) -> bool

@handle
struct CommandCall {
    sender: str,
    world: str,
    kind: str,
    isConsole: bool
}

impl CommandCall {
    fn reply(self, message: str)
    fn text(self, name: str) -> str
    fn integer(self, name: str) -> int
    fn decimal(self, name: str) -> float
    fn flag(self, name: str) -> bool
    fn player(self) -> Player?
}

fn configStr(key: str, fallback: str) -> str
fn configInt(key: str, fallback: int) -> int
fn configFloat(key: str, fallback: float) -> float
fn configBool(key: str, fallback: bool) -> bool
fn fileExists(path: str) -> bool
fn fileRead(path: str) -> str
fn fileWrite(path: str, text: str) -> bool

@handle
struct World {
    name: str,
    dimension: str,
    difficulty: str,
    time: int,
    dayTime: int,
    seed: int,
    raining: bool,
    thundering: bool
}

impl World {
    fn blockAt(self, x: int, y: int, z: int) -> str
    fn setBlock(self, x: int, y: int, z: int, block: str) -> bool
    fn setDayTime(self, ticks: int)
    fn setWeather(self, raining: bool, thundering: bool)
    fn gameRule(self, name: str) -> str
    fn setGameRule(self, name: str, value: str) -> bool
}

fn worldNamed(name: str) -> World?
fn defaultWorld() -> World?
fn worldCount() -> int

@handle
struct DataRows {
    count: int,
    columns: int
}

impl DataRows {
    fn cell(self, row: int, column: int) -> str
}

@handle
struct Entity {
    id: int,
    type: str,
    world: str,
    uuid: str,
    x: float,
    y: float,
    z: float,
    yaw: float,
    pitch: float,
    vx: float,
    vy: float,
    vz: float,
    health: float,
    width: float,
    height: float,
    age: int,
    alive: bool,
    onGround: bool,
    isPlayer: bool,
    customName: str
}

impl Entity {
    fn remove(self)
    fn teleport(self, x: float, y: float, z: float) -> bool
    fn setHealth(self, value: float)
    fn setRotation(self, yaw: float, pitch: float) -> bool
    fn setVelocity(self, x: float, y: float, z: float) -> bool
    fn player(self) -> Player?

    fn has(self, name: str) -> bool
    fn getBool(self, name: str) -> bool
    fn getInt(self, name: str) -> int
    fn getFloat(self, name: str) -> float
    fn getStr(self, name: str) -> str
    fn getRows(self, name: str) -> DataRows
    fn setBool(self, name: str, value: bool) -> bool
    fn setInt(self, name: str, value: int) -> bool
    fn setFloat(self, name: str, value: float) -> bool
    fn setStr(self, name: str, value: str) -> bool
    fn setList(self, name: str, items: str) -> bool

    fn call(self, op: str, args: str) -> str
    fn callBool(self, op: str, args: str) -> bool
    fn callInt(self, op: str, args: str) -> int
    fn callFloat(self, op: str, args: str) -> float
    fn callRows(self, op: str, args: str) -> DataRows

    fn damage(self, amount: float, cause: str, attackerId: int) -> bool
    fn kill(self) -> bool
    fn addEffect(self, effect: str, ticks: int, amplifier: int) -> bool
    fn removeEffect(self, effect: str) -> bool
    fn clearEffects(self)
    fn hasEffect(self, effect: str) -> bool
    fn effects(self) -> DataRows
    fn attribute(self, name: str) -> float
    fn attributeBase(self, name: str) -> float
    fn setAttributeBase(self, name: str, value: float) -> bool
    fn push(self, x: float, y: float, z: float)
    fn knockback(self, strength: float, towardsX: float, towardsZ: float)
    fn mount(self, vehicleId: int) -> bool
    fn dismount(self) -> bool
    fn eject(self) -> bool
}

fn entityById(id: int) -> Entity?
fn entityByUuid(uuid: str) -> Entity?
fn entityOfPlayer(p: Player) -> Entity?
fn worldEntities(world: World) -> DataRows
fn spawnEntity(world: World, type: str, x: float, y: float, z: float) -> Entity?
fn spawnEntityAs(world: World, type: str, x: float, y: float, z: float, yaw: float, reason: str) -> Entity?
fn dropItemAt(world: World, item: str, count: int, x: float, y: float, z: float, vx: float, vy: float, vz: float) -> int
fn explode(world: World, x: float, y: float, z: float, power: float, breakBlocks: bool, sourceId: int, fire: bool) -> bool

