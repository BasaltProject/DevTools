@handle
struct Scoreboard {}

impl Scoreboard {
    fn objectives(self) -> [str]
    fn addObjective(self, name: str, criterion: str, displayName: str, hearts: bool) -> bool
    fn removeObjective(self, name: str) -> bool
    fn display(self, slot: str, objective: str)
    fn clearDisplay(self, slot: str)
    fn displayed(self, slot: str) -> str?
    fn hasScore(self, entry: str, objective: str) -> bool
    fn score(self, entry: str, objective: str) -> int
    fn setScore(self, entry: str, objective: str, value: int) -> bool
    fn addScore(self, entry: str, objective: str, delta: int) -> int
    fn resetScore(self, entry: str, objective: str)
    fn resetEntry(self, entry: str)
    fn entries(self) -> [str]
    fn entriesIn(self, objective: str) -> [str]
    fn teams(self) -> [str]
    fn addTeam(self, name: str) -> bool
    fn removeTeam(self, name: str) -> bool
    fn setTeamStyle(self, team: str, displayName: str, prefix: str, suffix: str, color: str) -> bool
    fn setTeamRules(self, team: str, friendlyFire: bool, seeInvisible: bool, nameTags: str, deathMessages: str, collision: str) -> bool
    fn joinTeam(self, team: str, entry: str) -> bool
    fn leaveTeam(self, team: str, entry: str) -> bool
    fn teamOf(self, entry: str) -> str?
    fn members(self, team: str) -> [str]
    fn show(self, player: Player)
    fn release(self)
}

fn mainScoreboard() -> Scoreboard
fn createScoreboard() -> Scoreboard?
fn shownScoreboard(player: Player) -> Scoreboard

