<idea-plugin>
    <id>org.basaltmc.devtools</id>
    <name>Basalt DevTools</name>
    <vendor url="https://basaltmc.org">Basalt Project</vendor>
    <description><![CDATA[
        JetBrains IDE support for Basalt WebAssembly plugins: creates, builds, checks and packs a plugin with Kiln and lists
        what it finds in a tool window.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="org.basaltmc.devtools.intellij.BasaltSettings"/>
        <applicationConfigurable parentId="tools" instance="org.basaltmc.devtools.intellij.BasaltConfigurable"
                                 id="org.basaltmc.devtools.settings" displayName="Basalt"/>
        <toolWindow id="Basalt" anchor="bottom" factoryClass="org.basaltmc.devtools.intellij.ProblemsToolWindowFactory"
                    canCloseContents="false"/>
        <postStartupActivity implementation="org.basaltmc.devtools.intellij.StartupCheck"/>
        <notificationGroup id="Basalt" displayType="BALLOON"/>
    </extensions>

    <applicationListeners>
        <listener class="org.basaltmc.devtools.intellij.SaveListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </applicationListeners>

    <actions>
        <group id="Basalt.Menu" text="Basalt" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="Basalt.New" class="org.basaltmc.devtools.intellij.NewPluginAction" text="New Plugin"
                    description="Create a plugin with kiln new"/>
            <action id="Basalt.Build" class="org.basaltmc.devtools.intellij.BuildAction" text="Build"
                    description="Compile the plugin with Kiln"/>
            <action id="Basalt.Check" class="org.basaltmc.devtools.intellij.CheckAction" text="Check"
                    description="Run Kiln over the plugin"/>
            <action id="Basalt.Pack" class="org.basaltmc.devtools.intellij.PackAction" text="Pack"
                    description="Pack the plugin with Kiln"/>
        </group>
    </actions>
</idea-plugin>
